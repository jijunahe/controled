[Unit]
Description=Control LEDs WLED Orchestrator
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/CONTROL-LEDS/orchestrator
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/CONTROL-LEDS/orchestrator/.venv/bin/python orchestrator.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
