# Orquestador Raspberry Pi → MySQL → WLED
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=controled
DB_PASSWORD=controled_dev_1251
DB_NAME=control_leds

# IP por defecto si la config no tiene device_id
WLED_DEFAULT_IP=192.168.1.100
WLED_TIMEOUT_SECONDS=5

# Polling
POLL_INTERVAL_SECONDS=2.5

# true = no abre el USB (solo loguea el JSON)
DRY_RUN=true

# TTGO transmisora enchufada a la Raspberry. Recibe el JSON y lo pone en el aire.
LORA_USB_PORT=/dev/ttyACM0
LORA_USB_BAUD=115200

# Ruta HTTP (WLED TTGO con lora_rx acepta /json y /json/state)
WLED_JSON_PATH=/json/state

# Llave AES-128 (32 hex = 16 bytes). Misma que Config → Usermods → lora_rx → aes_key
# Vacío = envío en claro (solo si la TTGO aún no tiene llave).
# Con llave: body {"aes":"<base64 de 0xA1|nonce12|ciphertext|tag16>"}
WLED_AES_KEY=

# IPs de las TTGO configuradas como Transmisor en Usermods.
# A esas IPs el plaintext cifrado es MessagePack, no JSON.
# La TTGO reenvía la trama por LoRa sin volver a comprimir ni cifrar.
# Varias IPs separadas por coma. Vacío = todos los dispositivos reciben JSON por Wi-Fi.
WLED_LORA_GATEWAY_IPS=

# ============================================================================
# SINCRONIZACIÓN LORA (ejecución simultánea en todos los receptores)
# ============================================================================
# true = usar protocolo de dos fases para sincronizar receptores
# Fase 1: envía comando con sync=1 (receptores almacenan pero no ejecutan)
# Fase 2: después del delay, envía "exec" (todos ejecutan simultáneamente)
LORA_SYNC_ENABLED=true

# Milisegundos entre fase 1 (PREPARE) y fase 2 (EXECUTE)
# Debe ser suficiente para que todos los receptores reciban el primer paquete.
# Típico: 200-500ms. Aumentar si hay receptores lejanos o con mala señal.
LORA_SYNC_DELAY_MS=300
