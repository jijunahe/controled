[Unit]
Description=Control LEDs WLED Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=walter
WorkingDirectory=/home/walter/controled/CONTROL-LEDS/orchestrator
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/walter/controled/CONTROL-LEDS/orchestrator/.venv/bin/python orchestrator.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target